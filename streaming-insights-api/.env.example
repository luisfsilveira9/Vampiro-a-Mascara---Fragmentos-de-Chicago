# --- Spotify (Client Credentials Flow — nível de app, sem login de usuário) ---
# Crie um app em https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# ID do artista no Spotify (pegue da URL: open.spotify.com/artist/<ID>)
SPOTIFY_ARTIST_ID=

# --- YouTube (OAuth2 — precisa autorizar sua própria conta) ---
# Crie um projeto em https://console.cloud.google.com, habilite
# "YouTube Data API v3" e "YouTube Analytics API", e crie uma credencial
# OAuth Client ID do tipo "Desktop app".
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8787/oauth2callback
# Gerado automaticamente ao rodar: npm run auth:youtube
YOUTUBE_REFRESH_TOKEN=
